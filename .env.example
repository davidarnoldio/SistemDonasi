# Salin file ini menjadi .env.local, lalu isi nilainya dari
# Supabase Dashboard > Project Settings > API.
#
# Di Vercel, isi tiga variabel yang sama lewat
# Project Settings > Environment Variables.
#
# PENTING: hanya pakai anon (public) key.
# JANGAN PERNAH menaruh service_role key di frontend atau di repo ini.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# -------------------------------------------------------------------
# Edge Function URL (opsional, secara otomatis dihitung dari VITE_SUPABASE_URL).
# Jika kosong, fungsi dihitung otomatis sebagai:
#   https://<project-ref>.supabase.co/functions/v1/create-donation
# Isi manual jika nama project/variabel berbeda.
# -------------------------------------------------------------------
VITE_SUPABASE_EDGE_CREATE=
VITE_SUPABASE_EDGE_VERIFY=

# -------------------------------------------------------------------
# KREDENSIAL ADMIN (diisi saat deployment, bukan di .env.local).
# Di Vercel Project Settings > Environment Variables (non-production preview).
#
# ADMIN_EMAIL        = email login admin (mis. admin@kasihbersama.id)
# ADMIN_PASSWORD_HASH = SHA-256 hash dari password admin.
#   Buat hash (Node.js): node -e "crypto.createHash('sha256').update('password123').digest('hex')"
# -------------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
